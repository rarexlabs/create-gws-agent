    "codex",
    "agent",
    "scaffold"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rarexlabs/create-gws-agent.git"
  },
  "bugs": {
    "url": "https://github.com/rarexlabs/create-gws-agent/issues"
  },
  "homepage": "https://github.com/rarexlabs/create-gws-agent#readme"
