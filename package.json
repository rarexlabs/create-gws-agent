{
  "name": "create-gws-agent",
  "version": "0.0.8",
  "description": "Scaffold a minimal npm workspace for Gmail, Google Drive, and Google Calendar agents",
  "license": "MIT",
  "type": "module",
  "bin": {
    "create-gws-agent": "bin/create.mjs"
  },
  "files": [
    "bin/create.mjs",
    "template"
  ],
